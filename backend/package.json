{
  "name": "backend",
  "version": "1.0.0",
  "description": "Eliftech's test project: full stack web application - users can order food delivery",
  "main": "server.ts",
  "author": "PgkSoft",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mongoose": "^9.9.3",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "qs": "^6.15.3",
    "query-to-mongo": "^0.12.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "8"
  },
  "scripts": {
    "set-node": "nvm use 24.14.1",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start": "cross-env NODE_ENV=production node dist/src/server.js",
    "start:trace": "cross-env NODE_ENV=production NODE_OPTIONS='--trace-deprecation' node dist/src/server.js",
    "dev:trace": "cross-env NODE_ENV=development NODE_OPTIONS='--trace-deprecation' ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/server.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "8",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.6.3"
  }
}
