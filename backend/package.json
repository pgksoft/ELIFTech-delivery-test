{
  "name": "backend",
  "version": "1.0.0",
  "description": "Eliftech's test project: full stack web application - users can order food delivery",
  "main": "server.ts",
  "author": "PgkSoft",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mongoose": "^9.3.3",
    "pino": "^10.3.1",
    "uuid": "8"
  },
  "scripts": {
    "set-node": "nvm use 24.14.1",
    "dev": "ts-node-dev --require tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\""
